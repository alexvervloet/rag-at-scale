# Database
PG_DSN=postgresql://rag:rag@localhost:5433/ragscale

# Embedding provider: "ollama" (local, $0) or "voyage" (hosted, fast, ~free within tier)
EMBED_PROVIDER=ollama

# --- ollama (local) ---
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
# EMBED_DIM must match the model: nomic-embed-text = 768
EMBED_DIM=768

# --- voyage (hosted) ---
# Set EMBED_PROVIDER=voyage, then uncomment and fill these.
# VOYAGE_API_KEY=your-key-here
# VOYAGE_MODEL=voyage-4
# voyage-4 = 1024 dims; set EMBED_DIM=1024 when using it
# Concurrency knobs (0 = provider default of 128/8). Higher = faster embedding,
# up to Voyage's rate limit. ~768/32 measured ~1800 chunks/s here.
# EMBED_BATCH=768
# EMBED_WORKERS=32
